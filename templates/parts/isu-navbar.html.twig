{#
/**
 * @file
 * CSS styles for the official Iowa State Navbar 
 *
 * It is strongly recommended that the Iowa State Navbar be included in all
 * Iowa State University websites. If it is not desired or relevant, remove or
 * disable it. Never repurpose or modify in any way.
 *
 * Other required files:
 * - css/isu-navbar.css
 * - js/isu-navbar.js
 *
 * When the ISU navbar theme setting is "Local file", isu_navbar_html holds
 * the contents of local/isu-navbar.htm and replaces the default markup.
*/
#}

{% if isu_navbar_html %}
{{ isu_navbar_html }}
{% else %}
<nav class="isu-navbar" aria-label="Iowa State University quicklinks">
   <ul class="isu-navbar_container" id="isu-navbar">
      <li class="isu-navbar_break" aria-hidden="true"></li>
      <li><a href="https://www.iastate.edu/">ISU</a></li>
      <li><a href="https://www.extension.iastate.edu/news">News</a></li>
      <li><a href="https://store.extension.iastate.edu/">Store</a></li>
      <li><a href="https://www.extension.iastate.edu/countyservices/">Offices</a></li>
      <li><a class="isu-header-utility-button" href="{{ support_extension }}">Give</a></li>
   </ul>
</nav>
{% endif %}
