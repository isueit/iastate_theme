{#
/**
 * @file
 * Default theme implementation to display a menu.
 *
 * Available variables:
 * - menu_name: The machine name of the menu.
 * - items: A nested list of menu items. Each menu item contains:
 *   - attributes: HTML attributes for the menu item.
 *   - below: The menu item child items.
 *   - title: The menu link title.
 *   - url: The menu link url, instance of \Drupal\Core\Url
 *   - localized_options: Menu link localized options.
 *   - is_expanded: TRUE if the link has visible children within the current
 *     menu tree.
 *   - is_collapsed: TRUE if the link has children within the current menu tree
 *     that are not currently visible.
 *   - in_active_trail: TRUE if the link is in the active trail.
 *
 * @ingroup themeable
 */
#}
{% import _self as menus %}

{#
  We call a macro which calls itself to render the full tree.
  @see http://twig.sensiolabs.org/doc/tags/macro.html
#}

{{ menus.menu_links(items, attributes, 0) }}

{% macro menu_links(items, attributes, menu_level, parent_item) %}
  {% import _self as menus %}
  {% if items %}
    {% if menu_level == 0 %} {# If the menu has only one level. #}
      <ul {{ attributes.addClass('nav navbar-nav menubar') }}>
	{% elseif menu_level == 1 %}
      {# Long first-level dropdowns (more than 5 children) split into two columns on desktop. #}
      <ul class="isu-dropdown-menu{{ items|length > 5 ? ' isu-dropdown-menu--two-col' }}" aria-hidden="true">
	{% else %}
	  <ul class="isu-dropdown-menu isu-dropdown-submenu" aria-hidden="true">
    {% endif %}

    {# Output the parent page link as the first item in first-level dropdowns when it has a real URL. #}
    {% if menu_level == 1 and parent_item is not null %}
      {% set parent_url = parent_item.url|render|trim %}
      {% if parent_url and parent_url != '#' %}
        <li class="isu-dropdown-item isu-dropdown-parent-item">
          <a class="nav-link isu-nav-link isu-dropdown-parent-link" href="{{ parent_url }}">{{ parent_item.title }} <span class="arrow" aria-hidden="true"></span></a>
        </li>
      {% endif %}
    {% endif %}

    {% if menu_level == 1 and items|length > 5 %}
      {# Two columns: each is its own list so an expanded third level only
         lengthens its own column (no row gaps), and reading order runs down
         the left column, then the right. #}
      {% set column_size = (items|length / 2)|round(0, 'ceil') %}
      {% for column in items|batch(column_size) %}
        <li class="isu-dropdown-col">
          <ul class="isu-dropdown-col__list">
            {% for item in column %}
              {{ menus.menu_item(item, menu_level) }}
            {% endfor %}
          </ul>
        </li>
      {% endfor %}
    {% else %}
      {% for item in items %}
        {{ menus.menu_item(item, menu_level) }}
      {% endfor %}
    {% endif %}
    </ul>
  {% endif %}
{% endmacro %}

{% macro menu_item(item, menu_level) %}
  {% import _self as menus %}
  {# Assign classes based on if the item is an open parent, closed parent,
  active, or a has a submenu. #}
  {%
    set li_classes = [
      menu_level ? 'dropdown-item isu-dropdown-item' : 'nav-item',
      item.below ? 'isu-dropdown',
    ]
  %}

  {% if item.below %} {# If the item has children, it will be a dropdown. #}
    <li {{ item.attributes.addClass(li_classes) }}>
      <div class="isu-dropdown-toggle_wrapper {{ (menu_level) ? 'divsub' }}">
        <a class="nav-link isu-nav-link isu-dropdown-toggle {{ (menu_level) ? 'sub' }}" href="{{ item.url|render|trim ?: '#' }}" role="button" aria-expanded="false">{{ item.title }}</a>
        <button type="button" class="isu-dropdown-toggle_mobile" aria-expanded="false"><span class="fa fa-angle-down"></span><span class="sr-only">{{ item.title }} submenu</span></button>
      </div>

      {{ menus.menu_links(item.below, item.attributes, menu_level + 1, (menu_level == 0) ? item : null) }}
  {% else %} {# If the item does not have children, it will not be a dropdown. #}
    <li {{ item.attributes.addClass(li_classes) }}>
      <a class="nav-link isu-nav-link" href="{{ item.url|render|trim ?: '#' }}">{{ item.title }}{% if menu_level %}<span class="arrow" aria-hidden="true"></span>{% endif %}</a>
  {% endif %}
    </li>
{% endmacro %}

